# Copy to .env and adjust. .env is git-ignored and must never be committed.
# Every variable the service reads is listed here; test/config.test.ts fails if
# this file and src/config/env.ts drift apart.

# development | test | production
NODE_ENV=development

# Interface and port the HTTP server binds to.
HOST=0.0.0.0
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Origin used to build short links. Taken from config rather than from request
# headers, which a client controls.
BASE_URL=http://localhost:3000

# Matches the credentials in docker-compose.yml. Local development values only.
DATABASE_URL=postgres://shortener:shortener@localhost:5432/shortener

REDIS_URL=redis://localhost:6379

# Optional. If set, hashed and upserted at boot so local curls work.
# Leave blank to skip seeding. Never a production secret.
API_KEY=

# Pepper for hashing click IPs with the UTC date. Raw IPs are never stored.
# Change this in any non-local environment.
CLICK_IP_SALT=change-me-in-local-env
